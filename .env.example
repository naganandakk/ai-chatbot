AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key
CLAUDE_MODEL=anthropic/claude-haiku-4.5
CHAT_DATABASE_PATH=data/chat.duckdb
TOOLS_ENABLED=web_search
MAX_TOKENS=8192
# File attachments in the web app (defaults shown). The per-file limit is in MB, and the
# per-session limit caps the base64 bytes resent with every turn.
MAX_ATTACHMENT_MB=5
MAX_ATTACHMENTS_PER_MESSAGE=5
MAX_ATTACHMENTS_TOTAL_MB=10
MAX_SESSION_ATTACHMENTS_MB=20
# Session store: duckdb (default, local) or postgres (production)
CHAT_STORE=duckdb
# Used when CHAT_STORE=duckdb
CHAT_DATABASE_PATH=data/chat.duckdb
# Used when CHAT_STORE=postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Sign-in (web app). Required: the server will not start without these.
# Google OAuth client ID; its authorized JavaScript origins must include the dev URL.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Signs the access tokens. At least 32 characters, e.g. from: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
# Encrypts users' saved API keys. Comma-separated base64 32-byte keys, newest first.
# Generate one with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
KEY_ENCRYPTION_KEYS=your_base64_key
# Optional: restrict who may sign in (empty means any verified Google account)
# ALLOWED_EMAILS=you@example.com,friend@example.com
# ALLOWED_EMAIL_DOMAINS=example.com
# Secure cookies need HTTPS. Set to false only for plain-HTTP local runs.
# COOKIE_SECURE=false
# Rate limits on sign-in, key checks, and sending messages. Set to false only for local testing.
# RATE_LIMIT_ENABLED=true
